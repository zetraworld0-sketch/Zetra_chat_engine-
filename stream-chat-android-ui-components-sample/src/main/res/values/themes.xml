<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main App Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/stream_color_primary</item>
        <item name="colorPrimaryDark">@color/stream_color_primary_dark</item>
        <item name="colorAccent">@color/stream_color_accent</item>
        <item name="android:statusBarColor">@color/stream_color_primary_dark</item>
        <item name="streamUiTheme">@style/StreamTheme</item>
    </style>

    <!-- Corrected Stream UI Components Theme -->
    <style name="StreamTheme" parent="@style/StreamUiTheme">
        <!-- 1. WhatsApp Background Color (Removed 'Color' from the end) -->
        <item name="streamUiMessageListBackground">#ECE5DD</item>
        
        <!-- 2. WhatsApp Toolbar Color (Corrected name) -->
        <item name="streamUiToolbarBackground">@color/whatsapp_teal</item>
        
        <!-- 3. Netscape Logo (Corrected name) -->
        <item name="streamUiChannelListHeaderTitleIcon">@drawable/ic_netscape_logo</item>

        <item name="streamUiChannelActionsDialogStyle">@style/ChannelActionsDialogTheme</item>
        <item name="streamUiAudioRecordPlayerViewStyle">@style/AudioRecordPlayerViewTheme</item>
    </style>

    <style name="ChannelActionsDialogTheme" parent="StreamUi.ChannelList.ActionsDialog">
        <item name="streamUiChannelActionsViewInfoEnabled">true</item>
    </style>

    <style name="AudioRecordPlayerViewTheme" parent="StreamUi.AudioRecordPlayerView">
        <item name="streamUiAudioRecordPlayerFileIconContainerVisible">false</item>
    </style>
</resources>
